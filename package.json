{
  "name": "smart-vanity",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["mobile", "server"],
  "scripts": {
    "web-dev": "vite --mode web",
    "web-build": "vite build --mode web",
    "web-preview": "vite preview --mode web",
    
    "mobile:dev": "npm run dev --workspace mobile --",
    "mobile:dev:demo": "npm run dev:demo --workspace mobile --",
    "mobile:build": "npm run build --workspace mobile --",
    "mobile:build:demo": "npm run build:demo --workspace mobile --",
    "mobile:preview": "npm run preview --workspace mobile --",
    "android:init": "npm run android:init --workspace mobile --",
    "android:open": "npm run android:open --workspace mobile --",
    "android:sync": "npm run android:sync -- workspace mobile --",
  
    "server:deploy": "npm run deploy --workspace server --",
    "server:deploy:test": "npm run deploy:test --workspace server --",
    "server:start": "npm run start --workspace server --"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "sass": "^1.105.1",
    "vite": "^8.3.2",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-html-minifier": "^1.0.5",
    "vite-plugin-nunjucks": "^0.2.0"
  }
}
