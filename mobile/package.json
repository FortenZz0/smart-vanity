{
  "name": "smart-vanity-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode mobile",
    "build": "vue-tsc --noEmit -p app/tsconfig.json && vite build --mode mobile",
    "preview": "vite preview --mode mobile",
    "android:init": "npm run build && cap add android",
    "android:open": "cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "jeep-sqlite": "2.8.0",
    "sql.js": "1.11.0",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.14"
  }
}
